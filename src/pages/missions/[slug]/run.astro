---
/**
 * Mission runner page: SSR validates the slug, the island opens the run via the API. The island only gets
 * the learner-safe mission view: answer keys never ship in the page.
 */
import AppLayout from '../../../layouts/AppLayout.astro';
import MissionRunner from '../../../components/mission/MissionRunner';
import NotFound from '../../../components/ui/NotFound.astro';
import { getMission } from '../../../lib/content/loader';
import { learnerMissionView } from '../../../lib/learning/learner-mission-view';

const slug = Astro.params.slug ?? '';
const mission = getMission(slug);
const visible = mission?.status === 'published' ? learnerMissionView(mission) : null;
if (!visible) Astro.response.status = 404;
const sound = Astro.locals.learner?.profile.sound === true;
---
<AppLayout title={visible ? visible.title : 'Không tìm thấy'} bare>
  {visible ? (
    <MissionRunner client:load missionId={visible.id} mission={visible} sound={sound} />
  ) : (
    <NotFound what="mission này" backHref="/missions" backLabel="Xem danh sách mission" />
  )}
  <noscript>
    <p class="card mt-4">Trang làm bài cần bật JavaScript. Hãy bật JavaScript hoặc mở bằng trình duyệt khác nhé.</p>
  </noscript>
</AppLayout>
