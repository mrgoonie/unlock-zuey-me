---
/**
 * /insights: the learner's ai-tutor reports (reachable from /progress and Settings, not in BottomNav).
 * 404 unless insightsEnabledFor(env, learner), so with INSIGHTS_MODE=off the page does not exist.
 */
import AppLayout from '../layouts/AppLayout.astro';
import NotFound from '../components/ui/NotFound.astro';
import InsightsTimeline from '../components/insights/InsightsTimeline';
import { OBSERVABLE_ONLY_DISCLAIMER } from '../components/insights/insights-api';
import { insightsEnabledFor } from '../lib/insights/feature-flags';
import { listPublishedMissions } from '../lib/content/loader';

const learner = Astro.locals.learner;
const enabled = insightsEnabledFor(Astro.locals.runtime.env, learner);
if (!enabled) Astro.response.status = 404;
else Astro.response.headers.set('cache-control', 'no-store');
const missionTitles = Object.fromEntries(listPublishedMissions().map((m) => [m.id, `${m.emoji} ${m.title}`]));
---
{enabled ? (
  <AppLayout title="Báo cáo ai-tutor">
    <meta slot="head" name="robots" content="noindex, nofollow" />
    <div class="flex flex-col gap-4 pt-2">
      <header class="flex flex-col gap-2">
        <a href="/progress" class="btn-ghost self-start text-sm">← Tiến độ</a>
        <h1 class="text-2xl font-bold">🧭 Báo cáo ai-tutor</h1>
        <p class="text-sm text-ink-muted">
          Tóm tắt ngắn về các phiên bạn làm việc với AI trong Claude Code, do bộ phân tích nền ai-tutor trên máy chủ tạo ra. Chỉ bạn xem được, trừ khi bạn tự cho phép trong <a href="/settings#s-insights" class="font-semibold text-accent">Cài đặt</a>.
        </p>
        <p class="rounded-xl bg-line/40 p-3 text-sm" data-testid="insights-disclaimer">{OBSERVABLE_ONLY_DISCLAIMER}</p>
      </header>
      <InsightsTimeline client:load missionTitles={missionTitles} />
    </div>
  </AppLayout>
) : (
  <AppLayout title="Không tìm thấy">
    <NotFound what="trang" backHref="/home" backLabel="Về trang Hôm nay" />
  </AppLayout>
)}
