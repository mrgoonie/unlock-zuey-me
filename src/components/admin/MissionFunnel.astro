---
/** Per-mission funnel across runs: started → each step viewed/completed → submitted → passed. */
import type { MissionFunnel } from '../../lib/observer/queries';

interface Props { funnel: MissionFunnel[] }
const { funnel } = Astro.props;
const width = (n: number, max: number) => `${max ? Math.max(4, Math.round((n / max) * 100)) : 0}%`;
---
{funnel.length === 0 ? <p class="text-ink-muted">Chưa bắt đầu mission nào.</p> : (
  <div class="flex flex-col gap-5">
    {funnel.map((m) => {
      const rows = [
        { label: 'Bắt đầu', n: m.started, sub: '' },
        ...m.steps.map((s) => ({ label: s.title, n: s.completed, sub: `xem ${s.viewed} · xong ${s.completed}` })),
        { label: 'Nộp bằng chứng', n: m.submitted, sub: '' },
        { label: 'Đạt', n: m.passed, sub: '' },
      ];
      return (
        <div>
          <h4 class="font-semibold">{m.title}</h4>
          <ol class="mt-2 flex flex-col gap-1 text-sm">
            {rows.map((r) => (
              <li class="grid grid-cols-[minmax(0,10rem)_1fr_auto] items-center gap-2">
                <span class="truncate" title={r.label}>{r.label}</span>
                <span class="h-3 rounded-full bg-line/50" aria-hidden="true"><span class="block h-3 rounded-full bg-calm" style={`width:${width(r.n, m.started)}`} /></span>
                <span class="whitespace-nowrap tabular-nums text-xs">{r.sub || `${r.n} lượt`}</span>
              </li>
            ))}
          </ol>
        </div>
      );
    })}
  </div>
)}
