---
/** Coach (hint) and practice chat transcripts, grouped by run and channel, oldest message first. */
import type { CoachMessage } from '../../lib/observer/queries';
import { formatDateTime } from './admin-format';

interface Props { messages: CoachMessage[] }
const { messages } = Astro.props;
const groups = new Map<string, CoachMessage[]>();
for (const m of messages) {
  const key = `${m.runId ?? 'tự do'} · ${m.channel === 'hint' ? 'Gợi ý' : 'Chat luyện tập'}`;
  groups.set(key, [...(groups.get(key) ?? []), m]);
}
---
{messages.length === 0 ? <p class="text-ink-muted">Chưa có tin nhắn nào với trợ lý.</p> : (
  <div class="flex flex-col gap-3">
    {[...groups.entries()].map(([key, msgs]) => (
      <details class="rounded-xl border border-line p-3">
        <summary class="flex min-h-[44px] cursor-pointer items-center text-sm font-medium">
          {key.split(' · ')[1]} · {msgs.length} tin · {formatDateTime(msgs[0].createdAt)}
        </summary>
        <ol class="mt-2 flex flex-col gap-2 text-sm">
          {msgs.map((m) => (
            <li class:list={['max-w-[90%] rounded-xl p-2', m.role === 'user' ? 'self-end bg-accent/10' : 'self-start bg-line/40']}>
              <span class="block text-xs text-ink-muted">
                {m.role === 'user' ? 'Người học' : 'Trợ lý'}{m.hintLevel ? ` · nấc ${m.hintLevel}` : ''}{m.stepId ? ` · bước ${m.stepId}` : ''}
              </span>
              <p class="whitespace-pre-wrap break-words">{m.content}</p>
            </li>
          ))}
        </ol>
      </details>
    ))}
  </div>
)}
