{
  // AI Unlocked — Astro SSR on Cloudflare Workers (static assets + custom entrypoint in src/worker.ts).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "unlock-zuey-me",
  "main": "dist/_worker.js/index.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "account_id": "009dc0fcd0da3e503fbf38eb2b586e4b",
  "assets": { "directory": "dist", "binding": "ASSETS" },
  "routes": [{ "pattern": "unlock.zuey.me", "custom_domain": true }],
  "observability": { "enabled": true },
  // Push reminders: every 15 minutes the scheduled handler sends due reminders (src/lib/push).
  "triggers": { "crons": ["*/15 * * * *"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "unlock_zuey_me_db", "database_id": "86d8c2b0-f690-40a0-91b2-5c7685db7404", "migrations_dir": "migrations" }
  ],
  "kv_namespaces": [
    // Grants, clients and tokens of the /mcp OAuth provider (@cloudflare/workers-oauth-provider).
    { "binding": "OAUTH_KV", "id": "8faa58e5e2eb4276877b15411200f2d5" },
    // Rate-limit counters and short-lived caches.
    { "binding": "CACHE", "id": "b050a22b97df47608060ac04cf5c15b3" }
  ],
  // Private evidence screenshots; served only to the owner (and consenting observers) through the app.
  "r2_buckets": [{ "binding": "EVIDENCE", "bucket_name": "unlock-evidence" }],
  "ai": { "binding": "AI" },
  // Abuse throttles (src/lib/identity/request-rate-limits.ts keeps the same numbers for its fallback).
  // Counters are per Cloudflare location and approximate; period must be 10 or 60 seconds.
  "ratelimits": [
    { "name": "RL_GUEST_IP", "namespace_id": "261026001", "simple": { "limit": 20, "period": 60 } },
    { "name": "RL_AI_IP", "namespace_id": "261026002", "simple": { "limit": 30, "period": 60 } },
    { "name": "RL_WRITE_IP", "namespace_id": "261026003", "simple": { "limit": 120, "period": 60 } },
    { "name": "RL_WRITE_LEARNER", "namespace_id": "261026004", "simple": { "limit": 30, "period": 60 } }
  ],
  "vars": {
    "PUBLIC_SITE_URL": "https://unlock.zuey.me",
    "ZUEY_ISSUER": "https://zuey.me",
    "ADMIN_EMAILS": "digitop.vn@gmail.com,goon.nguyen@gmail.com,duynguyen@wearetopgroup.com,duy@wearetopgroup.com",
    "AI_DAILY_BUDGET_USD_PER_LEARNER": "0.30",
    "AI_DAILY_BUDGET_USD_GLOBAL": "5",
    // Global daily cap on Workers AI fallback calls (the per-learner cap lives in src/lib/coach/ai-models.ts).
    "AI_DAILY_WORKERS_AI_REQUESTS_GLOBAL": "2000",
    // Practice chat + hints may use at most this share of both global caps above; grading may use all of it.
    "AI_DAILY_COACH_SHARE": "0.5",
    "VAPID_SUBJECT": "mailto:digitop.vn@gmail.com",
    // ai-tutor insights (src/lib/insights/feature-flags.ts). off = every insights route 404, UI hidden, cron
    // no-op. Rollout: internal (admins) → pilot (+ INSIGHTS_PILOT_EMAILS) → on (all members).
    "INSIGHTS_MODE": "internal",
    "INSIGHTS_PILOT_EMAILS": "",
    // Report TTL in days; queue rows are always kept 7 days.
    "INSIGHTS_RETENTION_DAYS": "90",
    // ai-tutor analysis caps per UTC day (on top of the shared coaching AI budget).
    "INSIGHTS_DAILY_ANALYSES_PER_LEARNER": "12",
    "INSIGHTS_DAILY_ANALYSES_GLOBAL": "200",
    // off | issues | issues_ai_handle. Stays off without the GITHUB_ISSUES_TOKEN secret, whatever this says.
    "INSIGHTS_GITHUB_ISSUES": "off",
    "INSIGHTS_GITHUB_REPO": "mrgoonie/unlock-zuey-me"
  }
  // Secrets (wrangler secret put / CI): OPENROUTER_API_KEY, SESSION_SECRET, VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY,
  // GITHUB_ISSUES_TOKEN (optional; fine-grained PAT, Issues: write on INSIGHTS_GITHUB_REPO only)
}
